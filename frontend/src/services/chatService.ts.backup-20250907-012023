  role: 'user' | 'assistant';
  content: string;
  timestamp: Date;
  context?: any;
}

export interface ChatContext {
  productId?: string;
  productName?: string;
  productType?: 'food' | 'cosmetic' | 'detergent';
  scores?: {
    nova?: number;
    nutriscore?: string;
    healthScore?: number;
  };
  analysis?: any;
}

