// PATH: frontend/src/utils/navigation.ts

import { Location } from 'react-router-dom';

/**
 * Sauvegarde l'URL actuelle avant de rediriger vers login
 */
export const saveReturnUrl = (url: string) => {
  if (url.includes('/login') || url.includes('/register')) {
    return;
  }
  sessionStorage.setItem('returnUrl', url);
};

/**
 * Récupère l'URL de retour depuis query params OU sessionStorage
 * Priorité : 1) Query params 2) SessionStorage 3) /dashboard
 */
export const getReturnUrl = (location?: Location): string => {
  // 1. Essayer query params (depuis URL)
  if (location) {
    const params = new URLSearchParams(location.search);
    const returnUrl = params.get('returnUrl');
    if (returnUrl) {
      return decodeURIComponent(returnUrl);
    }
  }
  
  // 2. Essayer sessionStorage
  const storedUrl = sessionStorage.getItem('returnUrl');
  if (storedUrl) {
    sessionStorage.removeItem('returnUrl');
    return storedUrl;
  }
  
  // 3. Défaut
  return '/dashboard';
};

/**
 * Nettoie l'URL de retour
 */
export const clearReturnUrl = () => {
  sessionStorage.removeItem('returnUrl');
};