# Normalisation des fins de ligne
* text=auto eol=lf

# Forcer LF pour code
*.js     text eol=lf
*.ts     text eol=lf
*.tsx    text eol=lf
*.jsx    text eol=lf
*.json   text eol=lf
*.md     text eol=lf
*.css    text eol=lf
*.scss   text eol=lf
*.html   text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.sh     text eol=lf
*.ps1    text eol=crlf

# Binaires (pas de conversion)
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.webp   binary
*.ico    binary
*.pdf    binary
*.zip    binary
*.gz     binary
*.tar    binary
*.7z     binary
