  "mappingRules": {
    "description": "Règles de sélection automatique de l'habitude selon l'analyse du produit. L'IA utilise UNIQUEMENT ces règles, aucune création dynamique.",
    "priority": "La première règle matchée est sélectionnée (ordre = priorité).",
    "rules": [
      {
        "condition": {
          "novaGroup": 4,
          "additivesCount": { "$gte": 5 }
        },
        "habitId": "limiter-produits-ultra-transformes",
        "reasoning": "Produit ultra-transformé avec nombreux additifs"
      },
      {
        "condition": {
          "novaGroup": 4
        },
        "habitId": "limiter-produits-ultra-transformes",
        "reasoning": "Produit ultra-transformé"
      },
      {
        "condition": {
          "additivesCount": { "$gte": 3 }
        },
        "habitId": "limiter-exposition-chimique",
        "reasoning": "Produit avec plusieurs additifs"
      },
      {
        "condition": {
          "sugars100g": { "$gte": 20 }
        },
        "habitId": "limiter-sucres-ajoutes",
        "reasoning": "Produit très riche en sucres"
      },
      {
        "condition": {
          "sugars100g": { "$gte": 10 },
          "fiber100g": { "$lt": 3 }
        },
        "habitId": "associer-sucres-fibres-proteines",
        "reasoning": "Produit sucré sans fibres"
      },
      {
        "condition": {
          "salt100g": { "$gte": 1.5 }
        },
        "habitId": "limiter-sel-ajoute",
        "reasoning": "Produit très riche en sel"
      },
      {
        "condition": {
          "ingredientsCount": { "$gte": 15 }
        },
        "habitId": "lire-listes-ingredients",
        "reasoning": "Liste d'ingrédients très longue"
      },
      {
        "condition": {
          "novaGroup": 1,
          "organic": true
        },
        "habitId": "privilegier-aliments-bruts",
        "reasoning": "Aliment brut"
      },
      {
        "condition": {
          "categoryType": "food",
          "subcategory": { "$regex": "viande|charcuterie" }
        },
        "habitId": "limiter-viandes-rouges-charcuterie",
        "reasoning": "Viande ou charcuterie"
      },
      {
        "condition": {
          "categoryType": "food",
          "subcategory": { "$regex": "poisson" }
        },
        "habitId": "favoriser-poissons-gras",
        "reasoning": "Produit à base de poisson"
      },
      {
        "condition": {
          "fiber100g": { "$lt": 3 },
          "novaGroup": { "$gte": 3 }
        },
        "habitId": "augmenter-fibres-quotidiennes",
        "reasoning": "Produit transformé pauvre en fibres"
      },
      {
        "condition": {
          "default": true
        },
        "habitId": "surveiller-frequence-non-interdiction",
        "reasoning": "Habitude générale par défaut"
      }
    ]
  },
