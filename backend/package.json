
{
  "name": "ecolojia-backend",
  "version": "3.0.0",
  "private": true,
  "description": "Backend API for Ecolojia - Multi-category product analysis platform with AI (MongoDB)",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "dev:postgres": "nodemon server-postgres-fixed.js",
    "build": "echo \"No build needed - using JavaScript files directly\"",
    "test": "jest --coverage --detectOpenHandles",
    "test:watch": "jest --watch",
    "test:unit": "jest --testPathPattern=unit",
    "test:integration": "jest --testPathPattern=integration",
    "lint": "eslint src/ --ext .js",
    "lint:fix": "eslint src/ --ext .js --fix",
    "format": "prettier --write \"src/**/*.js\"",
    "migrate": "node scripts/migrate-pg-to-mongo.js",
    "migrate:verify": "node scripts/migrate-pg-to-mongo.js --verify",
    "seed": "node scripts/seed-data.js",
    "clean": "rm -rf node_modules package-lock.json && npm install"
  },
  "keywords": [
    "ecolojia",
    "api",
    "eco-friendly",
    "health-analysis",
    "express",
    "mongodb",
    "ai-analysis",
    "multi-category"
  ],
  "author": "Ecolojia Team",
  "license": "ISC",
  "dependencies": {
    "@google-cloud/vision": "^5.3.3",
    "@types/jspdf": "^1.3.3",
    "algoliasearch": "^4.25.2",
    "archiver": "^7.0.1",
    "axios": "^1.11.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.56.9",
    "cloudinary": "^2.7.0",
    "colors": "^1.4.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dayjs": "^1.11.10",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "express-async-handler": "^1.2.0",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.5.1",
    "express-validator": "^7.0.1",
    "form-data": "^4.0.4",
    "helmet": "^8.1.0",
    "joi": "^18.0.0",
    "json2csv": "^6.0.0-alpha.2",
    "jsonwebtoken": "^9.0.2",
    "jspdf": "^3.0.1",
    "lodash": "^4.17.21",
    "mongoose": "^8.16.5",
    "morgan": "^1.10.1",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "nodemailer": "^7.0.5",
    "pdfkit": "^0.17.1",
    "pdfmake": "^0.2.7",
    "pg": "^8.16.3",
    "rate-limit-redis": "^4.2.0",
    "redis": "^4.6.10",
    "sharp": "^0.33.5",
    "tesseract.js": "^6.0.1",
    "uuid": "^9.0.1",
    "validator": "^13.11.0",
    "winston": "^3.17.0",
    "zod": "^4.0.14"
  },
  "devDependencies": {
    "@faker-js/faker": "^8.3.1",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/pdfkit": "^0.17.2",
    "eslint": "^8.54.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.29.0",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^9.1.3",
    "nodemon": "^3.1.7",
    "prettier": "^3.1.0",
    "supertest": "^6.3.4"
  },
  "nodemonConfig": {
    "watch": ["src/", ".env"],
    "ext": "js,json",
    "ignore": ["src/**/*.test.js", "logs/*"],
    "env": { "NODE_ENV": "development" }
  },
  "main": "index.js",
  "engines": { "node": "20.x" }
}
